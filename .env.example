# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit it.

# ── Telegram Bot API ─────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, then get the token it gives you.
TELEGRAM_BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your personal chat ID, or a group/channel ID.
# To find your chat ID:
#   1. Start a chat with your bot (send /start).
#   2. Open: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   3. Look for "chat":{"id": ...} in the response.
TELEGRAM_CHAT_ID=123456789

# ── Finnhub (news / catalyst sentiment) ──────────────────────────────────────
# Free key: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── Schwab Market Data API (OAuth — probe via python schwab.py login) ────────
# App callback URL must match exactly (Production app on developer.schwab.com).
Client_ID_schwab=your_schwab_app_key
Client_Secret_schwab=your_schwab_app_secret
SCHWAB_REDIRECT_URI=https://developer.schwab.com/oauth2-redirect.html

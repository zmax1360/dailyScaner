<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Attribution health check near 16:30 ET.

  launchd StartCalendarInterval uses the *machine local* clock (F-23), not ET.
  We fire hourly and let health_check.py --require-et 16:30 gate on America/New_York
  so Pacific hosts / DST edges do not shift the effective run.

  Install:
    cp com.optiontrading.health-check.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.optiontrading.health-check.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.optiontrading.health-check</string>
  <key>WorkingDirectory</key>
  <string>/Users/alizafarianaraki/works/optionTrading</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/alizafarianaraki/works/Conda/anaconda3/bin/python</string>
    <string>/Users/alizafarianaraki/works/optionTrading/health_check.py</string>
    <string>--alert-on-fail</string>
    <string>--require-et</string>
    <string>16:30</string>
    <string>--et-window-min</string>
    <string>20</string>
  </array>
  <!-- Hourly local; --require-et selects the ~16:30 ET hour -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Minute</key>
      <integer>30</integer>
      <key>Hour</key>
      <integer>0</integer>
    </dict>

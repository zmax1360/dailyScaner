<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.optiontrading.nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/alizafarianaraki/works/optionTrading/nightly.sh</string>

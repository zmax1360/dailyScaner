  </array>

  <key>StandardOutPath</key>
  <string>/Users/alizafarianaraki/works/optionTrading/logs/nightly.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/alizafarianaraki/works/optionTrading/logs/nightly.launchd.log</string>
